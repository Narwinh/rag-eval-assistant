# Lightweight image for the free-tier hosted demo (e.g. Render's free web
# service, 512MB RAM). Unlike the main Dockerfile, this does NOT bundle
# Ollama - RAG_BACKEND=hosted makes src/rag.py call Google Gemini's free
# API for both embeddings and generation instead. See README "Local vs.
# hosted" section.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY data/processed/chunks.json ./data/processed/chunks.json
COPY faiss_index_hosted/ ./faiss_index_hosted/

ENV RAG_BACKEND=hosted
# GOOGLE_API_KEY must be set by the platform (e.g. as a Render secret) -
# never baked into the image or committed to the repo.

# Render (and most PaaS free tiers) inject $PORT at runtime; default to
# 8000 for plain `docker run` elsewhere.
ENV PORT=8000
EXPOSE 8000

CMD uvicorn src.serve:app --host 0.0.0.0 --port ${PORT}
