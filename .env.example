# Copy to .env (gitignored) and fill in real values. Never commit a real key.

# "local" (default): fully self-hosted via Ollama, zero API cost.
# "hosted": use Google Gemini's free-tier API instead (see README).
RAG_BACKEND=local

# Only needed when RAG_BACKEND=hosted. Get a free key at
# https://aistudio.google.com/apikey - do not commit this value anywhere.
GOOGLE_API_KEY=

# Only needed if Ollama isn't running on the default localhost:11434
# (e.g. a different host/port, or inside another container).
OLLAMA_BASE_URL=http://localhost:11434
